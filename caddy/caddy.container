[Unit]
Description=Caddy reverse proxy container
Documentation=https://caddyserver.com/
After=network-online.target crowdsec.service
After=proxy-net-network.service
Wants=network-online.target
Requires=crowdsec.service
Requires=proxy-net-network.service

[Container]
ContainerName=caddy
HostName=caddy
Image=localhost/caddy-custom:latest
EnvironmentFile=/etc/caddy/.caddy.env
AddCapability=NET_ADMIN
NoNewPrivileges=true
LogDriver=journald

PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp

Volume=caddy-data.volume:/data
Volume=caddy-config.volume:/config
Volume=caddy-logs.volume:/var/log/caddy
Volume=/etc/caddy:/etc/caddy:ro,Z
Volume=/etc/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=/home/william/kubbe-web:/var/www/kubbe-web:ro,Z

Network=crowdsec.network
# Connect to proxy-net with set ip
PodmanArgs=--network=proxy-net:ip=10.89.2.10,alias=caddy

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
TimeoutStopSec=90
SuccessExitStatus=0 143

[Install]
WantedBy=multi-user.target
DefaultInstance=default
