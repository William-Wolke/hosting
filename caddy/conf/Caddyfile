# Nothing here, just a catch-all for any other subdomains that are not defined above
*.{$CADDY_DOMAIN} {
	tls {
		dns duckdns {$CADDY_DDNS_TOKEN}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
		}
		format json
	}

	route {
		crowdsec
		respond "Not found" 404
	}
}
