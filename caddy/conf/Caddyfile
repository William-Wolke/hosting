{
	email {$CADDY_EMAIL}
	crowdsec {
		api_url http://crowdsec:8080
		api_key {$CROWDSEC_API_KEY}
		ticker_interval 15s
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
		}
		format json
	}
}

(private_proxy) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
		}
		format json
	}

	@local remote_ip 192.168.0.0/24 10.8.0.0/24

	handle @local {
		route {
			crowdsec
			reverse_proxy {args[0]}
		}
	}

	handle {
		route {
			crowdsec
			respond "Forbidden" 403
		}
	}
}

# Public services
{$CADDY_DOMAIN}, kubbe.{$CADDY_DOMAIN} {
	tls {
		dns duckdns {$CADDY_DDNS_TOKEN}
	}

	route {
		crowdsec
		root * /var/www/kubbe-web
		file_server
	}
}

