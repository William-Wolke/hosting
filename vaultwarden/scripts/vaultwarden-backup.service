[Unit]
Description=Vaultwarden Backup Service
After=docker.service
RequiresMountsFor=/mnt/storage-box-1

[Service]
Type=oneshot
Environment=DOCKER_CONTEXT=local
ExecStart=/opt/vaultwarden-backup/backup.sh /mnt/storage-box-1/backups/vaultwarden
User=william
Group=william

[Install]
WantedBy=multi-user.target
