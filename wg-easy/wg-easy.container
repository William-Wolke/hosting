[Unit]
Description=wg-easy (WireGuard UI)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=wg-easy
Image=ghcr.io/wg-easy/wg-easy:14
AutoUpdate=registry

Network=proxy-net.network
PodmanArgs=--network-alias=wg-easy

# Expose the VPN endpoint; Caddy accesses the UI over proxy-net.
PublishPort=51820:51820/udp

Volume=wg-easy-data.volume:/etc/wireguard

Environment=LANG=en
Environment=WG_DEFAULT_DNS=192.168.0.129
Environment=WG_ALLOWED_IPS=192.168.0.0/24,10.8.0.0/16
Environment=WG_DEVICE=eth0
EnvironmentFile=/etc/wg-easy/.wg-easy.env

AddCapability=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_MODULE
PodmanArgs=--sysctl=net.ipv4.ip_forward=1
PodmanArgs=--sysctl=net.ipv4.conf.all.src_valid_mark=1

LogDriver=journald

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900
SuccessExitStatus=0 143

[Install]
WantedBy=multi-user.target
