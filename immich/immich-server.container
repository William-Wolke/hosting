[Unit]
Description=Immich Server
Wants=network-online.target
After=network-online.target immich-postgres.service immich-valkey.service
Requires=immich-postgres.service immich-valkey.service
# Don't start until the storage box is mounted
RequiresMountsFor=/mnt/storage-box-1

[Container]
ContainerName=immich-server
Image=ghcr.io/immich-app/immich-server:v3.3.3
AutoUpdate=registry

Network=immich.network
Network=proxy-net.network
PodmanArgs=--network-alias=immich

# Photo library on the storage box
Volume=/mnt/storage-box-1/immich:/data
# Optional: keep thumbnails on local disk for speed (only set up on a fresh install)
# Volume=immich-thumbs.volume:/data/thumbs
Volume=/etc/localtime:/etc/localtime:ro

Environment=TZ=Europe/Stockholm
Environment=IMMICH_VERSION=v3.3.3
Environment=DB_HOSTNAME=immich-postgres
Environment=DB_USERNAME=postgres
Environment=DB_DATABASE_NAME=immich
Environment=REDIS_HOSTNAME=immich-valkey
Environment=IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003
# Set DB_PASSWORD
EnvironmentFile=/etc/immich/.immich.env

# --- AMD iGPU video transcoding (VAAPI) ---
AddDevice=/dev/dri
PodmanArgs=--group-add=video

LogDriver=journald

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
