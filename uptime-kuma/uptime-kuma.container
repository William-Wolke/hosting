[Unit]
Description=Uptime Kuma
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/etc/uptime-kuma

[Container]
ContainerName=uptime-kuma
Image=docker.io/louislam/uptime-kuma:2
AutoUpdate=registry

Network=proxy-net.network
PodmanArgs=--network-alias=uptime-kuma

Volume=uptime-kuma-data.volume:/app/data

EnvironmentFile=/etc/uptime-kuma/.uptime-kuma.env

LogDriver=journald

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
